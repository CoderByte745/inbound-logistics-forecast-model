    [...rows].reverse().map(r => `<tr class="${r.id === lastAdded ? 'new-row' : ''}">${
      s.cols.map(c => `<td>${esc(c === 'qty' ? fmt(r[c]) : r[c])}</td>`).join('')
    }<td><button class="del" title="Delete" data-del="${sec}|${esc(r.id)}">×</button></td></tr>`).join('')
  }</tbody></table>`;
}
function updateCounts() { Object.keys(SCHEMAS).forEach(sec => document.getElementById('count-' + sec).textContent = records[sec].length); updateRec(); }
function addRecord(sec, rec) { if (!rec.id) rec.id = genId(sec); records[sec].push(rec); lastAdded = rec.id; }

/* ---------- Recommended order quantity (from the chart's expected ordered quantity) ---------- */
function recommendFor(d) {
  const half = d.getDate() > 15;                            // same half-month periods as the chart
  const start = new Date(d.getFullYear(), d.getMonth(), half ? 16 : 1);
  const end = half ? new Date(d.getFullYear(), d.getMonth() + 1, 1) : new Date(d.getFullYear(), d.getMonth(), 16);
  const ordered = records.orders.reduce((n, o) => { const od = parseISO(o.orderDate); return od && od >= start && od < end ? n + (Number(o.qty) || 0) : n; }, 0);
  return { start, end, ordered, ...expectedForPeriod(start, end) };
}
let recValue = null;
function updateRec() {
  const box = document.getElementById('rec-box'), dateEl = document.getElementById('orders-orderDate'), qtyEl = document.getElementById('orders-qty');
  if (!box || !dateEl) return;
  const d = parseISO(dateEl.value);
  if (!d) { recValue = null; box.innerHTML = '<span class="rec-lbl">Recommended quantity</span><br>Pick an order date to see the recommendation.'; return; }
  const r = recommendFor(d), last = addDays(r.end, -1), f = x => `${x.getDate()} ${MONTHS[x.getMonth()]}`;
  const rec = Math.max(0, r.mid - r.ordered);              // what is still to order this period
  recValue = rec;
  const q = Number(qtyEl && qtyEl.value), total = r.ordered + q;   // period total if this order is added
  const flag = !q ? '' : total < r.low ? `<span class="rec-flag warn">Period total ${fmt(total)}: below expected range</span>` : total > r.high ? `<span class="rec-flag warn">Period total ${fmt(total)}: above expected range</span>` : `<span class="rec-flag ok">✓ Period total ${fmt(total)} within expected range</span>`;
  const note = r.ordered
    ? `Target ${fmt(r.mid)} − ${fmt(r.ordered)} already ordered in this period${rec === 0 ? ' — this period is already covered.' : '.'}`
    : `Target ${fmt(r.mid)} (no orders logged in this period yet).`;
  box.innerHTML =
    `<div class="rec-main"><span class="rec-lbl">Recommended</span><b>${fmt(rec)}</b><span>units</span>${flag}${rec > 0 ? '<button type="button" class="btn ghost small" id="rec-use">Use</button>' : ''}</div>` +
    `${note}<br>Expected range ${fmt(r.low)}–${fmt(r.high)} for orders placed ${f(r.start)}–${f(last)} ${last.getFullYear()}, arriving for demand ${f(r.needStart)} – ${f(addDays(r.needEnd, -1))} (${PLAN_LEAD_DAYS}-day lead time).`;
}

function bindEntryEvents() {
  const od = document.getElementById('orders-orderDate'), oq = document.getElementById('orders-qty'), rb = document.getElementById('rec-box');
  od.addEventListener('input', updateRec); od.addEventListener('change', updateRec); oq.addEventListener('input', updateRec);
  rb.addEventListener('click', e => {
    if (!e.target.closest('#rec-use') || recValue === null) return;
    oq.value = recValue; oq.closest('.field').classList.remove('invalid'); updateRec(); oq.focus();
  });
  Object.keys(SCHEMAS).forEach(sec => {
    const form = document.getElementById('form-' + sec);
    form.addEventListener('submit', e => {
      e.preventDefault();
      const s = SCHEMAS[sec]; let ok = true; const rec = {};
      s.fields.forEach(f => {
        const wrap = form.querySelector(`[data-key="${f.key}"]`), v = form.elements[f.key].value.trim();
        wrap.classList.remove('invalid'); void wrap.offsetWidth;
        if (f.req && !v) { wrap.classList.add('invalid'); ok = false; }
        rec[f.key] = v;
      });
      if (rec.id && records[sec].some(r => r.id === rec.id)) { toast(`${s.label} ID ${rec.id} already exists.`, true); return; }
      if (!ok) { toast('Please fill in the highlighted fields.', true); return; }
      addRecord(sec, rec); persist(); renderTable(sec); updateCounts();
      resetForm(sec); toast(`${s.label} ${rec.id} logged.`);
    });
    form.querySelectorAll('input,select').forEach(i => i.addEventListener('input', () => i.closest('.field').classList.remove('invalid')));
  });
  document.querySelectorAll('[data-reset]').forEach(b => b.addEventListener('click', () => resetForm(b.dataset.reset)));
  document.querySelectorAll('[data-template]').forEach(b => b.addEventListener('click', () => downloadTemplate(b.dataset.template)));
  document.querySelectorAll('[data-export]').forEach(b => b.addEventListener('click', () => exportRecords(b.dataset.export)));
  document.querySelectorAll('[data-clear]').forEach(b => b.addEventListener('click', () => {
    const sec = b.dataset.clear;
    if (records[sec].length && confirm(`Delete all ${records[sec].length} logged ${SCHEMAS[sec].label.toLowerCase()}s?`)) {
      records[sec] = []; persist(); renderTable(sec); updateCounts();
    }
  }));
  document.getElementById('sections').addEventListener('click', e => {
    const d = e.target.closest('[data-del]'); if (!d) return;
    const [sec, id] = d.dataset.del.split('|');
    records[sec] = records[sec].filter(r => r.id !== id); persist(); renderTable(sec); updateCounts();
  });
  document.querySelectorAll('.dropzone').forEach(dz => {
    const sec = dz.dataset.drop;
    dz.addEventListener('click', () => { pendingSec = sec; document.getElementById('fileInput').click(); });
    ['dragenter', 'dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('drag'); }));
    ['dragleave', 'drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('drag'); }));
    dz.addEventListener('drop', e => { if (e.dataTransfer.files[0]) importFile(sec, e.dataTransfer.files[0]); });
  });
}
function resetForm(sec) {
  const form = document.getElementById('form-' + sec);
  form.reset();
  form.querySelectorAll('.invalid').forEach(x => x.classList.remove('invalid'));
  SCHEMAS[sec].fields.filter(f => f.today).forEach(f => form.elements[f.key].value = todayISO());
  updateRec();
}

/* ---------- Excel import / export ---------- */
document.getElementById('fileInput').addEventListener('change', e => {
  const f = e.target.files[0]; if (f) importFile(pendingSec, f); e.target.value = '';
});
function cellToString(v) {
  if (v instanceof Date) return new Date(v.getTime() + 12 * 3600 * 1000).toISOString().slice(0, 10);
  return v === null || v === undefined ? '' : String(v).trim();
}
function importFile(sec, file) {
  if (typeof XLSX === 'undefined') { toast('Excel library could not load (are you offline?).', true); return; }
  const reader = new FileReader();
  reader.onload = ev => {
    try {
      const wb = XLSX.read(new Uint8Array(ev.target.result), { type: 'array', cellDates: true });
      const rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: '', raw: true });
      if (!rows.length) { toast('The file has no data rows.', true); return; }
      const s = SCHEMAS[sec], map = {};
      s.fields.forEach(f => { map[norm(f.label)] = f; map[norm(f.key)] = f; });
      let added = 0, skipped = 0, dupes = 0;
      rows.forEach(row => {
        const rec = {};
        Object.keys(row).forEach(h => { const f = map[norm(h)]; if (f) rec[f.key] = cellToString(row[h]); });
        s.fields.forEach(f => { if (rec[f.key] === undefined) rec[f.key] = ''; });
        if (s.fields.some(f => f.req && !rec[f.key])) { skipped++; return; }
        if (rec.id && records[sec].some(r => r.id === rec.id)) { dupes++; return; }
        addRecord(sec, rec); added++;
      });
      persist(); renderTable(sec); updateCounts();
      const extra = [skipped && `${skipped} skipped (missing required fields)`, dupes && `${dupes} duplicate ID${dupes > 1 ? 's' : ''} ignored`].filter(Boolean).join(', ');
      toast(`${added} ${s.label.toLowerCase()}${added === 1 ? '' : 's'} imported${extra ? ' · ' + extra : ''}.`, added === 0);
    } catch (err) { toast('Could not read that file. Use .xlsx, .xls or .csv.', true); }
  };
  reader.readAsArrayBuffer(file);
}
function downloadTemplate(sec) {
  if (typeof XLSX === 'undefined') { toast('Excel library could not load (are you offline?).', true); return; }
  const s = SCHEMAS[sec], ws = XLSX.utils.aoa_to_sheet([s.fields.map(f => f.label)]);
  ws['!cols'] = s.fields.map(f => ({ wch: Math.max(14, f.label.length + 4) }));
  const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, s.label + 's');
  XLSX.writeFile(wb, `${sec}_template.xlsx`);
}
function exportRecords(sec) {
  if (typeof XLSX === 'undefined') { toast('Excel library could not load (are you offline?).', true); return; }
  if (!records[sec].length) { toast('Nothing to export yet.', true); return; }
  const s = SCHEMAS[sec];
  const aoa = [s.fields.map(f => f.label), ...records[sec].map(r => s.fields.map(f => r[f.key] ?? ''))];
  const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(aoa), s.label + 's');
  XLSX.writeFile(wb, `${sec}_${realTodayISO()}.xlsx`);
}
document.getElementById('seg').addEventListener('click', e => {
  const b = e.target.closest('.seg-btn'); if (!b) return;
  activeSec = b.dataset.sec;
  document.querySelectorAll('.seg-btn').forEach(x => x.classList.toggle('active', x === b));
  document.querySelectorAll('.section-view').forEach(v => v.classList.toggle('active', v.id === 'sec-' + activeSec));
  movePill('segPill', b, 4);
});

/* ---------- Test-date widget ---------- */
function updateSimUI() {
  const on = !!simDate, d = nowDate(), pill = document.getElementById('simPill'), tog = document.getElementById('simToggle');
  document.getElementById('simInput').value = isoOf(d);
  pill.classList.toggle('on', on); pill.textContent = on ? `🧪 Test date: ${fmtDate(d)}` : '';
  tog.classList.toggle('on', on); tog.textContent = on ? `🧪 ${fmtDate(d)}` : '🧪 Test date';
  const h = hiddenCount();
  document.getElementById('simStatus').textContent = on
    ? `The dashboard is showing ${fmtDate(d)}. Records dated after it are hidden${h ? ` (${h} hidden)` : ''}; Data Entry is unaffected.`
    : 'Using the real date. Pick a date to see how the dashboard reacts.';
}
function setSimDate(d) {
  const prev = todayISO();
  simDate = d ? startOfDay(d) : null;
  const now = todayISO();
  Object.keys(SCHEMAS).forEach(sec => {                 // keep "today" defaults in the entry forms in step
    const form = document.getElementById('form-' + sec); if (!form) return;
    SCHEMAS[sec].fields.filter(f => f.today).forEach(f => { const el = form.elements[f.key]; if (el && (!el.value || el.value === prev)) el.value = now; });
  });
  updateSimUI(); updateRec(); renderDashboard(); updateLeadUI();
}
/* Lead time control: changes the planning lead time used by the optimal range, expected order quantities,
   CNY order window/deadline and the historic comparison. */
function updateLeadUI() {
  document.getElementById('leadInput').value = PLAN_LEAD_DAYS;
  const dl = cnyInfo(CNY_DATES[1]).deadline;
  const j1 = document.getElementById('jumpDeadline'), j2 = document.getElementById('jumpAfter');
  j1.dataset.jump = isoOf(dl); j2.dataset.jump = isoOf(addDays(dl, 1));
  document.getElementById('leadStatus').textContent =
    `Planning lead time: ${PLAN_LEAD_DAYS} days${PLAN_LEAD_DAYS === DEFAULT_LEAD_DAYS ? ' (default)' : ` (default ${DEFAULT_LEAD_DAYS})`}. ` +
    `Avg actual from logged orders: ${lastAvgLead === null || lastAvgLead === undefined ? '—' : lastAvgLead + ' days'}. ` +
    `CNY 2027 order deadline: ${fmtDate(dl)}.`;
  document.getElementById('leadReset').disabled = PLAN_LEAD_DAYS === DEFAULT_LEAD_DAYS;
}
function setLead(n) {
  n = Math.round(Number(n));
  if (!isFinite(n)) { updateLeadUI(); return; }
  PLAN_LEAD_DAYS = Math.min(365, Math.max(1, n));
  updateRec(); renderDashboard(); updateLeadUI();
}
document.getElementById('leadInput').addEventListener('change', e => setLead(e.target.value));
document.getElementById('leadReset').addEventListener('click', () => setLead(DEFAULT_LEAD_DAYS));
document.getElementById('simPanel').addEventListener('click', e => {
  const b = e.target.closest('[data-lead]'); if (b) setLead(PLAN_LEAD_DAYS + Number(b.dataset.lead));
});

const simPanel = document.getElementById('simPanel');
document.getElementById('simToggle').addEventListener('click', () => simPanel.classList.toggle('open'));
document.getElementById('simPill').addEventListener('click', () => simPanel.classList.add('open'));
document.getElementById('simClose').addEventListener('click', () => simPanel.classList.remove('open'));
document.getElementById('simInput').addEventListener('change', e => { const d = parseISO(e.target.value); if (d) setSimDate(d); });
document.getElementById('simReset').addEventListener('click', () => setSimDate(null));
simPanel.addEventListener('click', e => {
  const st = e.target.closest('[data-step]'), jp = e.target.closest('[data-jump]');
  if (st) { const b = startOfDay(nowDate()); setSimDate(new Date(b.getFullYear(), b.getMonth(), b.getDate() + Number(st.dataset.step))); }
  if (jp) setSimDate(parseISO(jp.dataset.jump));
});

/* ---------- Historic: expected vs actual ordered quantity ---------- */
let histTf = '6M';
function histPeriods(tf) {                                  // completed order periods, oldest first
  const today = startOfDay(nowDate()), half = tf !== '12M', out = [];
  for (let m = 0; m < 240; m++) {
    const b = new Date(FORECAST_START.year, FORECAST_START.month + m, 1);
    const mid = new Date(b.getFullYear(), b.getMonth(), 16), nx = new Date(b.getFullYear(), b.getMonth() + 1, 1);
    for (const p of (half ? [[b, mid], [mid, nx]] : [[b, nx]])) { if (p[1] > today) return out; out.push(p); }
  }
  return out;
}
function renderHistory() {
  document.querySelectorAll('#histToggle .toggle-btn').forEach(b => b.classList.toggle('active', b.dataset.h === histTf));
  movePill('histPill', document.querySelector('#histToggle .toggle-btn.active'), 3);
  const half = histTf !== '12M', keep = histTf === '3M' ? 6 : 12;
  const rows = histPeriods(histTf).slice(-keep).map(([s, e]) => {
    const x = expectedForPeriod(s, e), yy = "'" + String(s.getFullYear()).slice(2);
    const act = records.orders.reduce((n, o) => { const d = parseISO(o.orderDate); return d && d >= s && d < e ? n + (Number(o.qty) || 0) : n; }, 0);
    const lbl = half ? `${MONTHS[s.getMonth()]} ${s.getDate() === 1 ? 1 : 2} ${yy}` : `${MONTHS[s.getMonth()]} ${yy}`;
    return { s, e, lbl, act, ...x, st: act < x.low ? 'below' : act > x.high ? 'above' : 'within' };
  });
  document.getElementById('hist-empty').hidden = rows.length > 0;
  document.getElementById('hist-content').hidden = !rows.length;
  if (!rows.length) return;

  const L = 60, R = 680, B = 260, T = 20, n = rows.length;
  const top = Math.max(...rows.map(d => Math.max(d.high, d.act)));
  const maxU = Math.max(800, Math.ceil(top / 200) * 200), step = maxU > 1600 ? 400 : 200, yS = (B - T) / maxU;
  const X = i => n > 1 ? L + i * (R - L) / (n - 1) : (L + R) / 2;
  const hi = rows.map((d, i) => [X(i), B - d.high * yS]), lo = rows.map((d, i) => [X(i), B - d.low * yS]), ac = rows.map((d, i) => [X(i), B - d.act * yS]);
  const col = { within: '#1F6FEB', below: '#C62828', above: '#C62828' };
  let g = '';
  for (let j = 0; j <= maxU; j += step) {
    const y = B - j * yS;
    g += `<line x1="${L}" y1="${y}" x2="${R}" y2="${y}" stroke="#E5E7EB"/><text x="${L - 6}" y="${y + 4}" font-size="10" fill="#6B7280" text-anchor="end">${j}</text>`;
  }
  if (n > 1) {
    g += `<path d="${getBandPath(hi, lo)}" fill="#BBDEFB" opacity="0.55"/>` +
         `<path d="${getSmoothPath(hi)}" fill="none" stroke="#64B5F6" stroke-width="1.5" stroke-dasharray="4 4"/>` +
         `<path d="${getSmoothPath(lo)}" fill="none" stroke="#90CAF9" stroke-width="1.5" stroke-dasharray="4 4"/>` +
         `<path d="${getSmoothPath(ac)}" fill="none" stroke="#1F6FEB" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>`;
  } else {
    g += `<line x1="${hi[0][0]}" y1="${hi[0][1]}" x2="${lo[0][0]}" y2="${lo[0][1]}" stroke="#BBDEFB" stroke-width="14" stroke-linecap="round" opacity="0.8"/>`;
  }
  rows.forEach((d, i) => {
    const tip = `${d.lbl}: expected ${fmt(d.low)}–${fmt(d.high)}, actual ${fmt(d.act)} (${d.st === 'within' ? 'within range' : d.st + ' range'})`;
    g += `<circle cx="${ac[i][0]}" cy="${ac[i][1]}" r="5" fill="${col[d.st]}" stroke="#fff" stroke-width="1.5"><title>${tip}</title></circle>` +
         `<text x="${X(i)}" y="280" font-size="${n > 8 ? 9 : 10}" fill="#6B7280" text-anchor="middle">${d.lbl}</text>`;
  });
  document.getElementById('histChart').innerHTML = g;

  const c = k => rows.filter(r => r.st === k).length;
  const sum = (k) => rows.reduce((t, r) => t + r[k], 0);
  document.getElementById('hist-summary').innerHTML =
    `<b>${c('within')} of ${n}</b> periods within the expected range · ${c('below')} below · ${c('above')} above<br>` +
    `Total ordered <b>${fmt(sum('act'))}</b> vs expected ${fmt(sum('low'))}–${fmt(sum('high'))} over ${fmtDate(rows[0].s)} – ${fmtDate(addDays(rows[n - 1].e, -1))}`;

  document.getElementById('hist-body').innerHTML = [...rows].reverse().map(d => {
    const cls = d.st === 'within' ? 'yes' : 'no', txt = d.st === 'within' ? 'Within range' : d.st === 'below' ? 'Below range' : 'Above range';
    return `<tr><td>${d.lbl}</td><td>${fmt(d.low)}–${fmt(d.high)}</td><td>${fmt(d.act)}</td><td class="${cls}">${txt}</td></tr>`;
  }).join('');
}
document.getElementById('histToggle').addEventListener('click', e => {
  const b = e.target.closest('[data-h]'); if (!b) return;
  histTf = b.dataset.h; renderHistory();
});

/* ---------- init ---------- */
renderSections();
updateSimUI();
renderDashboard();
updateLeadUI();
if ((location.hash || '') === '#entry') showPage('entry'); else movePill('navPill', document.querySelector('.nav-btn.active'), 3);
window.addEventListener('resize', () => {
  movePill('navPill', document.querySelector('.nav-btn.active'), 3);
  movePill('togglePill', document.querySelector('#toggleGroup .toggle-btn.active'), 3);
  movePill('histPill', document.querySelector('#histToggle .toggle-btn.active'), 3);
  movePill('segPill', document.querySelector('.seg-btn.active'), 4);
});
</script>
