<script>
/* =====================================================
   SHARED HELPERS
   ===================================================== */
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const DAY = 86400000;
const fmt = n => Number(n).toLocaleString('en-US');
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const norm = s => String(s).toLowerCase().replace(/[^a-z0-9]/g, '');
const startOfDay = d => new Date(d.getFullYear(), d.getMonth(), d.getDate());
const parseISO = s => {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s || ''));
  if (!m) return null;
  const d = new Date(+m[1], +m[2] - 1, +m[3]);
  return isNaN(d) ? null : d;
};
const fmtDate = d => `${String(d.getDate()).padStart(2, '0')} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
const isoOf = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
/* Test clock: when simDate is set, the whole dashboard behaves as if it were that day. */
let simDate = null;
const nowDate = () => simDate ? new Date(simDate) : new Date();
const todayISO = () => isoOf(nowDate());
const realTodayISO = () => isoOf(new Date());
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function movePill(pillId, activeEl, pad) {
  const pill = document.getElementById(pillId);
  if (!activeEl || !activeEl.offsetWidth) return;
  pill.style.width = activeEl.offsetWidth + 'px';
  pill.style.transform = `translateX(${activeEl.offsetLeft - pad}px)`;
}
function showPage(name) {
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.page === name));
  document.querySelectorAll('.page').forEach(p => p.classList.toggle('active', p.id === 'page-' + name));
  movePill('navPill', document.querySelector('.nav-btn.active'), 3);
  if (name === 'dashboard') renderDashboard();
  else movePill('segPill', document.querySelector('.seg-btn.active'), 4);
  try { history.replaceState(null, '', '#' + name); } catch (e) {}
}
document.querySelectorAll('.nav-btn').forEach(b => b.addEventListener('click', () => showPage(b.dataset.page)));

/* =====================================================
   RECORD STORE (shared by both pages)
   ===================================================== */
const STORE_KEY = 'kjeldsens_records_v1';
let records = { orders: [], deliveries: [], dispatches: [] };
try { const s = JSON.parse(localStorage.getItem(STORE_KEY)); if (s) records = Object.assign(records, s); } catch (e) {}
const persist = () => { try { localStorage.setItem(STORE_KEY, JSON.stringify(records)); } catch (e) {} };

/* Records visible to the dashboard. With a test date active, anything dated after it
   has not happened yet, so it is hidden (the Data Entry page always shows everything). */
function recordsAsOf() {
  if (!simDate) return records;
  const cut = isoOf(simDate), keep = (arr, k) => arr.filter(r => { const d = String(r[k] || '').slice(0, 10); return !d || d <= cut; });
  return { orders: keep(records.orders, 'orderDate'), deliveries: keep(records.deliveries, 'receivedDate'), dispatches: keep(records.dispatches, 'dispatchDate') };
}
const hiddenCount = () => { const R = recordsAsOf(); return ['orders', 'deliveries', 'dispatches'].reduce((n, k) => n + records[k].length - R[k].length, 0); };

/* =====================================================
   DASHBOARD
   ===================================================== */
// Forecast (prediction) numbers — kept as-is
const forecastSets = {
  '3M': [
    { date: 'Nov 1', low: 200, high: 300 }, { date: 'Nov 2', low: 200, high: 310 },
    { date: 'Dec 1', low: 220, high: 350 }, { date: 'Dec 2', low: 250, high: 450 },
    { date: 'Jan 1', low: 300, high: 600 }, { date: 'Jan 2', low: 300, high: 650 }
  ],
  '6M': [
    { date: 'Nov 1', low: 200, high: 300 }, { date: 'Nov 2', low: 200, high: 310 },
    { date: 'Dec 1', low: 220, high: 350 }, { date: 'Dec 2', low: 250, high: 450 },
    { date: 'Jan 1', low: 300, high: 600 }, { date: 'Jan 2', low: 300, high: 650 },
    { date: 'Feb 1', low: 250, high: 450 }, { date: 'Feb 2', low: 220, high: 380 },
    { date: 'Mar 1', low: 180, high: 280 }, { date: 'Mar 2', low: 170, high: 260 },
    { date: 'Apr 1', low: 160, high: 240 }, { date: 'Apr 2', low: 150, high: 230 }
  ],
  '12M': [
    { date: 'Nov', low: 200, high: 300 }, { date: 'Dec', low: 220, high: 450 },
    { date: 'Jan', low: 300, high: 650 }, { date: 'Feb', low: 250, high: 450 },
    { date: 'Mar', low: 180, high: 280 }, { date: 'Apr', low: 160, high: 240 },
    { date: 'May', low: 150, high: 220 }, { date: 'Jun', low: 140, high: 210 },
    { date: 'Jul', low: 150, high: 220 }, { date: 'Aug', low: 160, high: 250 },
    { date: 'Sep', low: 180, high: 300 }, { date: 'Oct', low: 200, high: 320 }
  ]
};
const FORECAST_START = { year: 2026, month: 10 };       // Nov 2026
let OPTIMAL = { min: 0, max: 0 };                // optimal stock range (units)
const DEFAULT_LEAD_DAYS = 65;
let PLAN_LEAD_DAYS = DEFAULT_LEAD_DAYS;          // planning lead time; can be changed from the test widget
let lastAvgLead = null;
let currentData = [], currentTf = '6M', ordersOutside = 0;

/* ---- derive everything from logged records ---- */
function computeState() {
  const today = startOfDay(nowDate()), R = recordsAsOf();
  const q = r => Number(r.qty) || 0;

  const receivedAll = {};    // by order id (any condition)
  let usableReceived = 0;
  R.deliveries.forEach(d => {
    receivedAll[d.orderId] = (receivedAll[d.orderId] || 0) + q(d);
    if (d.condition !== 'Damaged') usableReceived += q(d);
  });
  const dispatched = R.dispatches.reduce((s, r) => s + q(r), 0);
  const stock = Math.max(0, usableReceived - dispatched);

  const open = R.orders
    .map(o => ({ ...o, remaining: q(o) - (receivedAll[o.id] || 0) }))
    .filter(o => o.remaining > 0)
    .sort((a, b) => String(a.eta).localeCompare(String(b.eta)));
  // In-transit = total ordered − total delivered
  const totalOrdered = R.orders.reduce((s, o) => s + q(o), 0);
  const totalDelivered = R.deliveries.reduce((s, d) => s + q(d), 0);
  const inTransit = Math.max(0, totalOrdered - totalDelivered);

  // actual lead time
  const lead = [];
  R.deliveries.forEach(d => {
    const o = R.orders.find(x => x.id === d.orderId);
    const a = o && parseISO(o.orderDate), b = parseISO(d.receivedDate);
    if (a && b && b >= a) lead.push((b - a) / DAY);
  });
  const avgLead = lead.length ? Math.round(lead.reduce((s, x) => s + x, 0) / lead.length) : null;

  // batches
  const batches = {};
  R.deliveries.forEach(d => {
    if (d.condition === 'Damaged' || !d.batchId) return;
    const b = batches[d.batchId] || (batches[d.batchId] = { id: d.batchId, qty: 0, expiry: null });
    b.qty += q(d);
    const e = parseISO(d.expiry);
    if (e && (!b.expiry || e < b.expiry)) b.expiry = e;
  });
  R.dispatches.forEach(d => { if (d.batchId && batches[d.batchId]) batches[d.batchId].qty -= q(d); });
  const expiring = Object.values(batches).filter(b => b.qty > 0 && b.expiry).sort((a, b) => a.expiry - b.expiry);

  return { today, stock, open, inTransit, avgLead, expiring };
}

/* ---- Demand model (shared by the stock meter and the chart) ----
   Each forecast value is the demand over ~15 days, so rate/day = value / 15.
   Nov–Apr use the half-month figures (6M set); May–Oct use the monthly figures (12M set).
   The seasonal cycle is assumed to repeat after 12 months so the shifted windows never run out of data. */
function demandRate(dt) {
  const m = (dt.getFullYear() - FORECAST_START.year) * 12 + dt.getMonth() - FORECAST_START.month;
  let f;
  if (m < 0) f = forecastSets['6M'][0];
  else { const k = m % 12; f = k < 6 ? forecastSets['6M'][k * 2 + (dt.getDate() > 15 ? 1 : 0)] : forecastSets['12M'][k]; }
  return { lo: f.low / 15, hi: f.high / 15 };
}
function demandBetween(start, end) {                       // [start, end)
  let lo = 0, hi = 0;
  for (let t = new Date(start); t < end; t.setDate(t.getDate() + 1)) { const r = demandRate(t); lo += r.lo; hi += r.hi; }
  return { lo, hi };
}
const round10 = n => Math.round(n / 10) * 10;
const addDays = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);

/* Optimal stock range = expected demand from today over the lead-time window. */
function computeOptimal(today) {
  const r = demandBetween(today, addDays(today, PLAN_LEAD_DAYS));
  return { min: round10(r.lo), max: round10(r.hi) };
}

/* ---- Chinese New Year calendar (actual dates) ----
   For each CNY: the demand peak runs from 36 days before to 5 days before CNY (for CNY 6 Feb 2027 that is 1 Jan – 1 Feb 2027).
   The order window is that peak shifted back by the lead time, and the order deadline is the lead time plus a
   10-day buffer before CNY (6 Feb 2027 → 23 Nov 2026). The card follows the CNY whose order window began most recently. */
const CNY_DATES = [new Date(2026, 1, 17), new Date(2027, 1, 6), new Date(2028, 0, 26), new Date(2029, 1, 13),
                   new Date(2030, 1, 3), new Date(2031, 0, 23), new Date(2032, 1, 11), new Date(2033, 0, 31)];
const CNY_ORDER_BUFFER_DAYS = 10;
function cnyInfo(c) {
  const peak = { start: addDays(c, -36), end: addDays(c, -5) };
  return { cny: c, peak, windowStart: addDays(peak.start, -PLAN_LEAD_DAYS), windowEnd: addDays(peak.end, -PLAN_LEAD_DAYS),
           deadline: addDays(c, -(PLAN_LEAD_DAYS + CNY_ORDER_BUFFER_DAYS)) };
}
function activeCny(today) {
  const list = CNY_DATES.map(cnyInfo);
  let cur = list[0];
  list.forEach(x => { if (x.windowStart <= today) cur = x; });
  return { cur, next: list.find(x => x.windowStart > today) || null };
}
const cnyPeakFor = Y => { const c = CNY_DATES.find(d => d.getFullYear() === Y + 1); return c ? cnyInfo(c).peak : null; };   // peak after a Nov–Oct chart cycle starting in year Y

/* Expected ordered quantity: to have goods on the shelf when demand happens, an order must be
   placed one lead time earlier. For each order period, take the demand of the window that starts
   PLAN_LEAD_DAYS later — i.e. the demand curve shifted back by the lead time. */
const TF_MONTHS = { '3M': 3, '6M': 6, '12M': 12 };
/* The chart shows the cycle starting Nov 2026. Once today (or the test date) reaches the end of
   the window for a view, that view moves on to the same cycle one year later (the seasonal pattern repeats). */
function chartYear(tf) {
  const today = startOfDay(nowDate()); let y = FORECAST_START.year;
  while (today >= new Date(y, FORECAST_START.month + TF_MONTHS[tf], 1)) y++;
  return y;
}
function periodRange(tf, i) {                              // [start, end) of order period i
  const Y = chartYear(tf), M = FORECAST_START.month;
  if (tf === '12M') return [new Date(Y, M + i, 1), new Date(Y, M + i + 1, 1)];
  const m = Math.floor(i / 2);
  return i % 2 ? [new Date(Y, M + m, 16), new Date(Y, M + m + 1, 1)] : [new Date(Y, M + m, 1), new Date(Y, M + m, 16)];
}
function expectedForPeriod(s, e) {                          // expected ordered quantity for orders placed in [s, e)
  const needStart = addDays(s, PLAN_LEAD_DAYS), needEnd = addDays(e, PLAN_LEAD_DAYS);
  const r = demandBetween(needStart, needEnd);
  return { low: round10(r.lo), high: round10(r.hi), mid: round10((r.lo + r.hi) / 2), needStart, needEnd };
}
function expectedOrderSeries(tf, len) {
  return Array.from({ length: len }, (_, i) => { const [s, e] = periodRange(tf, i); return expectedForPeriod(s, e); });
}

function orderedSeries(tf, len) {
  // Chart data uses every logged order, so it does not change with the test date
  const out = new Array(len).fill(0); ordersOutside = 0;
  const Y = chartYear(tf);
  records.orders.forEach(o => {
    const d = parseISO(o.orderDate); if (!d) { ordersOutside++; return; }
    const m = (d.getFullYear() - Y) * 12 + d.getMonth() - FORECAST_START.month;
    if (m < 0) { ordersOutside++; return; }
    const idx = tf === '12M' ? m : m * 2 + (d.getDate() > 15 ? 1 : 0);
    if (idx < len) out[idx] += Number(o.qty) || 0; else ordersOutside++;
  });
  return out;
}

/* ---- count-up ---- */
function countUp(el, duration = 1200, delay = 350) {
  const target = parseInt(el.dataset.count, 10) || 0;
  if (reduceMotion || target === 0) { el.textContent = fmt(target); return; }
  const start = performance.now() + delay;
  function tick(now) {
    const t = Math.min(Math.max((now - start) / duration, 0), 1);
    el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - t, 4))));
    if (t < 1) requestAnimationFrame(tick);
  }
  el.textContent = '0';
  requestAnimationFrame(tick);
}
function setCount(id, n) { const el = document.getElementById(id); el.dataset.count = n; countUp(el); }

/* ---- stock meter + warning ---- */
function updateMeter(stock, inTransit) {
  const scaleMax = Math.max(2000, Math.ceil(Math.max(stock * 1.1, OPTIMAL.max * 1.25) / 500) * 500);
  const minP = OPTIMAL.min / scaleMax * 100, maxP = OPTIMAL.max / scaleMax * 100;
  const val = Math.min(stock / scaleMax * 100, 100);

  const span = maxP - minP, g1 = minP + span * 0.3, g2 = maxP - span * 0.3;
  document.getElementById('meterBar').style.background =
    `linear-gradient(90deg, #E53935 0%, #FDD835 ${minP}%, #43A047 ${g1}%, #43A047 ${g2}%, #FDD835 ${maxP}%, #E53935 100%)`;
  document.getElementById('lnMin').style.left = minP + '%';
  document.getElementById('lnMax').style.left = maxP + '%';
  document.getElementById('numMin').textContent = fmt(OPTIMAL.min);
  document.getElementById('numMax').textContent = fmt(OPTIMAL.max);
  document.getElementById('scaleMax').textContent = fmt(scaleMax);
  document.getElementById('meterNote').textContent =
    `Optimal range = forecast demand (low–high) over the next ${PLAN_LEAD_DAYS}-day lead time; updates each period.`;

  const meter = document.getElementById('stockMeter');
  meter.classList.remove('play'); void meter.offsetWidth; meter.classList.add('play');

  const dot = document.getElementById('meterDot');
  dot.style.transition = 'none'; dot.style.left = '0%'; void dot.offsetWidth;
  dot.style.transition = reduceMotion ? 'none' : ''; dot.style.left = val + '%';

  const pill = document.getElementById('stockPill'), warn = document.getElementById('stockWarning'), wt = document.getElementById('stockWarningText');
  const wasHidden = warn.hidden;
  if (stock < OPTIMAL.min) {
    pill.className = 'pill red'; pill.textContent = 'Below optimal range';
    wt.textContent = `Low stock: ${fmt(OPTIMAL.min - stock)} units below the optimal minimum of ${fmt(OPTIMAL.min)}. ` +
      (inTransit > 0 ? `${fmt(inTransit)} units are in transit — check arrival dates.` : 'No orders in transit — consider placing an order.');
    warn.hidden = false;
  } else if (stock > OPTIMAL.max) {
    pill.className = 'pill red'; pill.textContent = 'Above optimal range';
    wt.textContent = `Overstock: ${fmt(stock - OPTIMAL.max)} units above the optimal maximum of ${fmt(OPTIMAL.max)}. Consider holding new orders.`;
    warn.hidden = false;
  } else {
    pill.className = 'pill green'; pill.textContent = 'OK · within optimal range';
    warn.hidden = true;
  }
  if (!warn.hidden) { warn.style.animation = 'none'; void warn.offsetWidth; warn.style.animation = ''; }
}

