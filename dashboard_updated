/* ---- chart ---- */
function curveSegments(points) {
  let d = '';
  for (let i = 0; i < points.length - 1; i++) {
    const p0 = i === 0 ? points[i] : points[i - 1], p1 = points[i], p2 = points[i + 1];
    const p3 = i + 2 < points.length ? points[i + 2] : p2;
    d += ` C ${p1[0] + (p2[0] - p0[0]) / 6},${p1[1] + (p2[1] - p0[1]) / 6} ${p2[0] - (p3[0] - p1[0]) / 6},${p2[1] - (p3[1] - p1[1]) / 6} ${p2[0]},${p2[1]}`;
  }
  return d;
}
const getSmoothPath = pts => pts.length ? `M ${pts[0][0]},${pts[0][1]}` + curveSegments(pts) : '';
function getBandPath(upper, lower) {
  const rev = [...lower].reverse();
  return getSmoothPath(upper) + ` L ${rev[0][0]},${rev[0][1]}` + curveSegments(rev) + ' Z';
}

const needLabel = d => { const e = addDays(d.needEnd, -1), f = x => `${x.getDate()} ${MONTHS[x.getMonth()]}`; return `${f(d.needStart)} – ${f(e)}`; };

function setView(tf) {
  document.getElementById('legendExp').textContent = `Expected ordered quantity (demand shifted back ${PLAN_LEAD_DAYS}-day lead time)`;
  currentTf = tf;
  document.querySelectorAll('#toggleGroup .toggle-btn').forEach(btn => btn.classList.toggle('active', btn.textContent === tf));
  movePill('togglePill', document.querySelector('#toggleGroup .toggle-btn.active'), 3);

  const base = forecastSets[tf], ordered = orderedSeries(tf, base.length), expected = expectedOrderSeries(tf, base.length);
  const data = base.map((d, i) => ({ date: d.date, yr: periodRange(tf, i)[0].getFullYear(), ...expected[i], ord: ordered[i] }));
  currentData = data;
  const wStart = periodRange(tf, 0)[0], wEnd = addDays(periodRange(tf, base.length - 1)[1], -1);
  document.getElementById('chartRange').textContent = `${MONTHS[wStart.getMonth()]} ${wStart.getFullYear()} – ${MONTHS[wEnd.getMonth()]} ${wEnd.getFullYear()}`;

  const L = 60, R = 680, B = 260, T = 20;
  const top = Math.max(...data.map(d => Math.max(d.high, d.ord)));
  const maxU = Math.max(800, Math.ceil(top / 200) * 200), step = maxU > 1600 ? 400 : 200;
  const xStep = (R - L) / (data.length - 1), yS = (B - T) / maxU;
  const hi = [], lo = [], od = [];
  let xl = '', hz = '';
  data.forEach((d, i) => {
    const x = L + i * xStep;
    hi.push([x, B - d.high * yS]); lo.push([x, B - d.low * yS]); od.push([x, B - d.ord * yS]);
    xl += `<text x="${x}" y="280">${d.date}</text>`;
    const zl = i === 0 ? L - 20 : x - xStep / 2, zr = i === data.length - 1 ? R + 20 : x + xStep / 2;
    hz += `<rect x="${zl}" y="${T}" width="${zr - zl}" height="${B - T}" fill="transparent" data-index="${i}"/>`;
  });

  const band = document.getElementById('area-band'), line = document.getElementById('solid-line');
  band.classList.remove('animated-band'); line.classList.remove('animated-line'); void line.offsetWidth;
  band.setAttribute('d', getBandPath(hi, lo));
  line.setAttribute('d', getSmoothPath(od));
  document.getElementById('dashed-high').setAttribute('d', getSmoothPath(hi));
  document.getElementById('dashed-low').setAttribute('d', getSmoothPath(lo));
  band.classList.add('animated-band'); line.classList.add('animated-line');

  document.getElementById('line-markers').innerHTML = od.map((p, i) =>
    `<circle class="marker" cx="${p[0]}" cy="${p[1]}" r="4" fill="#1F6FEB" stroke="#fff" stroke-width="1.5" style="animation-delay:${600 + i * 70}ms"/>`).join('');
  document.getElementById('x-axis-labels').innerHTML = xl;
  document.getElementById('hover-zones').innerHTML = hz;

  let ax = '';
  for (let j = 0; j <= maxU; j += step) {
    const y = B - j * yS;
    ax += `<line x1="${L}" y1="${y}" x2="${R}" y2="${y}" stroke="#E5E7EB" stroke-width="1"/><text x="${L - 6}" y="${y + 4}" font-size="10" fill="#6B7280" text-anchor="end">${j}</text>`;
  }
  document.getElementById('chart-axes').innerHTML = ax;

  // Shade the order periods whose goods land in the CNY demand peak (peak demand shifted back by the lead time)
  let cny = '';
  const pk = cnyPeakFor(chartYear(tf));
  const hit = pk ? data.map((d, i) => (d.needStart < pk.end && d.needEnd > pk.start) ? i : -1).filter(i => i >= 0) : [];
  if (hit.length) {
    const xs = Math.max(L, L + (hit[0] - 0.5) * xStep), xe = Math.min(L + (hit[hit.length - 1] + 0.5) * xStep, R + 20);
    cny += `<rect x="${xs}" y="${T}" width="${xe - xs}" height="${B - T}" fill="#FFF8E1" opacity="0"><animate attributeName="opacity" from="0" to="0.6" dur="0.8s" begin="0.4s" fill="freeze"/></rect>`;
    cny += `<text x="${xs + 6}" y="16" text-anchor="start" font-size="11" fill="#B8860B" font-weight="600">CNY order window</text>`;
  }
  document.getElementById('chart-cny').innerHTML = cny;

  // "Today" marker (follows the test date)
  const tdy = startOfDay(nowDate());
  let tx = null;
  for (let i = 0; i < data.length; i++) {
    const [a, b] = periodRange(tf, i);
    if (tdy >= a && tdy < b) { tx = Math.max(L, Math.min(R, L + (i - 0.5 + (tdy - a) / (b - a)) * xStep)); break; }
  }
  document.getElementById('chart-today').innerHTML = tx === null ? '' :
    `<line x1="${tx}" y1="${T}" x2="${tx}" y2="${B}" stroke="#111827" stroke-width="1.5" stroke-dasharray="3 3"/>` +
    `<text x="${tx}" y="6" text-anchor="middle" font-size="10" font-weight="700" fill="#111827">${simDate ? 'Test date' : 'Today'}</text>`;

  document.getElementById('forecast-table-body').innerHTML = data.map((d, i) => {
    const inRange = d.ord >= d.low && d.ord <= d.high;
    return `<tr class="row-in" style="--r:${i}"><td>${d.date}</td><td>${fmt(d.low)}–${fmt(d.high)}</td><td>${fmt(d.ord)}</td><td class="${inRange ? 'yes' : 'no'}">${inRange ? 'Yes' : 'No'}</td><td>${needLabel(d)}</td></tr>`;
  }).join('');
  document.getElementById('table-footer-text').innerText =
    `Showing next ${tf === '3M' ? 3 : tf === '6M' ? 6 : 12} order months. Expected ordered quantity = forecast demand shifted back by the ${PLAN_LEAD_DAYS}-day lead time (goods ordered in a period arrive to cover the demand shown in “Serves Demand Of”). Ordered quantity = orders logged, grouped by order date.` +
    (ordersOutside ? ` ${ordersOutside} order${ordersOutside === 1 ? '' : 's'} dated outside this window not shown.` : '') +
    (tx === null ? ' The current date is outside this chart window.' : '');
  setupTooltips(xStep, L);
}

function setupTooltips(xStep, L) {
  const tip = document.getElementById('tooltip'), tr = document.getElementById('trackerLine');
  const wrap = document.getElementById('chartWrap'), svg = document.getElementById('forecastChart');
  document.querySelectorAll('#hover-zones rect').forEach(z => {
    z.addEventListener('mouseenter', e => {
      const idx = parseInt(e.target.getAttribute('data-index')), d = currentData[idx];
      document.getElementById('tt-title').innerText = `${d.date} ${d.yr}`;
      document.getElementById('tt-need').innerText = needLabel(d);
      document.getElementById('tt-ord').innerText = fmt(d.ord);
      document.getElementById('tt-low').innerText = fmt(d.low);
      document.getElementById('tt-high').innerText = fmt(d.high);
      const sr = svg.getBoundingClientRect(), wr = wrap.getBoundingClientRect();
      const lp = sr.left - wr.left + ((L + idx * xStep) / 720) * sr.width;
      tr.style.left = `${lp}px`; tr.classList.add('visible');
      const tw = tip.offsetWidth || 200; let tl = lp + 15; if (tl + tw > wr.width) tl = lp - tw - 10;
      tip.style.left = `${tl}px`; tip.style.top = '20px'; tip.classList.add('visible');
    });
    z.addEventListener('mouseleave', () => { tip.classList.remove('visible'); tr.classList.remove('visible'); });
  });
}

